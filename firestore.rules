rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLASCUser() {
      return request.auth != null
          && request.auth.token.email.matches('.*@lascusa\\.com');
    }

    function isManager() {
      return isLASCUser()
          && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
          && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'manager';
    }

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: any LASC user can read.
    // Self-create only on first login (role must be 'staff' — prevents self-promotion).
    // Only managers can update roles or delete users.
    match /users/{email} {
      allow read: if isLASCUser();
      // Self-create on first login: role must be 'staff' (prevents self-promotion)
      // Manager can pre-create any user doc with any role
      allow create: if isLASCUser() && (
        (email == request.auth.token.email && request.resource.data.role == 'staff')
        || isManager()
      );
      allow update, delete: if isManager();
    }

    // Scheduler — manager writes only
    match /teachers/{doc} {
      allow read: if isLASCUser();
      allow write: if isManager();
    }
    match /sessions/{doc} {
      allow read: if isLASCUser();
      allow write: if isManager();
    }
    match /pt_contracts/{doc} {
      allow read: if isLASCUser();
      allow write: if isManager();
    }

    // Book catalog — manager writes only
    match /books/{doc} {
      allow read: if isLASCUser();
      allow write: if isManager();
    }

    // Inventory stock levels — staff can write (needed for sell transactions)
    match /inventory/{doc} {
      allow read: if isLASCUser();
      allow write: if isLASCUser();
    }

    // Sales records — staff can write (process sales at counter)
    match /sales/{doc} {
      allow read: if isLASCUser();
      allow write: if isLASCUser();
    }

    // Stock in/out, transfers, orders — manager only
    match /stock_history/{doc} {
      allow read: if isLASCUser();
      allow write: if isManager();
    }
    match /stock_out/{doc} {
      allow read: if isLASCUser();
      allow write: if isManager();
    }
    match /transfers/{doc} {
      allow read: if isLASCUser();
      allow write: if isManager();
    }
    match /pending_orders/{doc} {
      allow read: if isLASCUser();
      allow write: if isManager();
    }
  }
}
